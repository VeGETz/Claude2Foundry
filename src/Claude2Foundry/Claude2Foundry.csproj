<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- Set SkipUiBuild=true to skip pnpm and embed whatever is already in wwwroot/_ui/ -->
    <SkipUiBuild Condition="'$(SkipUiBuild)' == ''">false</SkipUiBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.8" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
  </ItemGroup>

  <!--
    BuildUI: runs pnpm install + build to compile the Adapter Console SPA.
    Hard-fails when pnpm is unavailable so the binary is never silently empty.
    Skip with /p:SkipUiBuild=true when pre-built assets are already present.
  -->
  <Target Name="BuildUI"
          BeforeTargets="EmbedUiAssets"
          Condition="'$(SkipUiBuild)' != 'true'">
    <Exec Command="pnpm install --frozen-lockfile --ignore-scripts"
          WorkingDirectory="$(MSBuildProjectDirectory)/../../" />
    <Exec Command="pnpm run build"
          WorkingDirectory="$(MSBuildProjectDirectory)/../../ui" />
  </Target>

  <!--
    EmbedUiAssets: registers SPA output as EmbeddedResource items.
    Must run BEFORE _CalculateEmbeddedFilesManifestInputs (a DependsOnTargets
    of PrepareResourceNames) — BeforeTargets="PrepareResourceNames" fires too
    late because DependsOnTargets are resolved first.
    Hard-fails if index.html is absent so the binary is never silently empty.
  -->
  <Target Name="EmbedUiAssets"
          AfterTargets="BuildUI"
          BeforeTargets="_CalculateEmbeddedFilesManifestInputs">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\_ui\dist\index.html')"
           Text="UI build did not produce wwwroot/_ui/dist/index.html. Ensure pnpm is on PATH or set /p:SkipUiBuild=true to embed pre-built assets." />
    <ItemGroup>
      <EmbeddedResource Include="$(MSBuildProjectDirectory)\wwwroot\_ui\dist\**\*" />
    </ItemGroup>
  </Target>

</Project>
